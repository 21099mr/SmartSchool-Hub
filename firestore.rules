rules_version = '2';

// Paste this whole file into Firebase > Firestore Database > Rules, then click Publish.
// IMPORTANT: change admin@example.com below to YOUR admin email (same as in js/firebase-config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@example.com';
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Every account has one profile document.
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid);
      allow delete: if isAdmin();
    }

    // The history the admin reads. Users can only add lines about themselves.
    match /activity/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    match /homework/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /attendance/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Only the admin can post announcements. Everyone signed in can read them.
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /lostfound/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.thumb.size() < 100000;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
